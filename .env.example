APP_NAME="Repuestos de motos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_TIMEZONE=America/Caracas

# Base de datos real: PostgreSQL con el esquema «tienda» (instálalo con database/sql/00_instalar.sql … 10_contabilidad.sql).
# PRODUCCIÓN SaaS: DB_USERNAME=saas_app (nunca postgres; el RLS solo protege a
# roles no superusuario y la app ABORTA al arranque si detecta un superusuario).
# Usa .env.production.example como base del despliegue.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tienda
DB_USERNAME=postgres
DB_PASSWORD=
DB_SEARCH_PATH=tienda,public

# Multiinquilino: dominio base del que cuelgan los subdominios de las tiendas
# (la-cava.misitiolibre.com → subdominio «la-cava» en tienda.estado_tenants).

# Sin tablas de Laravel: sesiones y caché en archivos.
SESSION_DRIVER=file
SESSION_LIFETIME=480
# Cookie de sesión solo por HTTPS. En local no hace falta; en producción el
# .env.production.example la trae en true (config/session.php ya la activa por
# defecto cuando APP_ENV no es local).
# SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
AUTH_MODEL=App\Models\Usuario

# ── Observabilidad N1 ────────────────────────────────────────────────────────
# Token Bearer del endpoint /metrics (Prometheus). VACÍO = endpoint cerrado
# (403 siempre). En staging/producción pon un valor aleatorio largo.
METRICS_TOKEN=
# Canal del log de acceso (una línea por petición). Vacío = desactivado.
LOG_ACCESO=acceso

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ExchangeRate-API (tasas de cambio). Consigue tu clave en https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=

# ── Base del portal (portal_saas): planes, suscripciones y pagos ──
# Usuario con permiso de ESCRIBIR tienda.estado_tenants (propagador: suspensiones y plan). Vacío = usa DB_USERNAME.
# Contraseña del panel del super administrador del portal (/portal)
