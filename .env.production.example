# ─────────────────────────────────────────────────────────────────────────────
#  PLANTILLA DE PRODUCCIÓN · sistema SaaS POS multiinquilino (Laravel 12)
#  Copia a .env en el servidor y completa los valores marcados.
#  Auditoría 2026-11-15: este archivo existe para que NINGÚN despliegue arranque
#  con la configuración de desarrollo (.env.example es solo para local).
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Repuestos de motos"
APP_ENV=production
APP_DEBUG=false              # NUNCA true en producción: expone .env, SQL y stack traces
APP_KEY=                     # php artisan key:generate (único por servidor)
APP_URL=https://misitiolibre.com
APP_LOCALE=es
APP_TIMEZONE=America/Caracas

# ── Base de las tiendas (RLS: el rol NUNCA puede ser superusuario) ──────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tienda
DB_USERNAME=saas_app         # rol NO superusuario (ALTER ROLE saas_app LOGIN PASSWORD '…')
DB_PASSWORD=
DB_SEARCH_PATH=tienda,public

# ── Conexión ADMINISTRATIVA (solo el propagador y el alta de cuentas la usan) ──
# Debe ser un rol con derechos de superusuario/propietario distinto de saas_app.
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=

# ── Dominio base del SaaS (obligatorio en producción) ────────────────────────
SAAS_BASE_DOMAIN=misitiolibre.com

# ── Sesiones / caché ─────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true   # la app servirá por HTTPS (obligatorio con dominio público)
CACHE_STORE=file
QUEUE_CONNECTION=sync
AUTH_MODEL=App\Models\Usuario

LOG_CHANNEL=stack
LOG_LEVEL=error              # en producción no se registran mensajes de depuración

# ── Tasa de cambio automática (opcional) ─────────────────────────────────────
EXCHANGERATE_API_KEY=

# ── Base del portal (portal_saas): usa el rol de mínimos privilegios (42_portal_rol.sql) ──
PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=5432
PORTAL_DB_DATABASE=portal_saas
PORTAL_DB_USERNAME=portal_app   # rol SOLO-LECTURA + funciones portal.fn_* (ver 42_portal_rol.sql)
PORTAL_DB_PASSWORD=

# ── Panel del super administrador del portal ─────────────────────────────────
# Contraseña ÚNICA y LARGA del operador (vacía = panel deshabilitado, por defecto).
PORTAL_ADMIN_PASSWORD=
